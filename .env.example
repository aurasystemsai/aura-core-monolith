er# Aura Platform - Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env with real credentials to Git

# ==============================================
# CORE APPLICATION
# ==============================================

NODE_ENV=development
PORT=10000
APP_URL=http://localhost:10000

# ==============================================
# SHOPIFY INTEGRATION
# ==============================================

what ev# Shopify OAuth. Use this pair OR the commented CLIENT_ID/CLIENT_SECRET aliases below.
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_client_secret
# Public client ID used by App Bridge; keep this in sync with SHOPIFY_API_KEY.
VITE_SHOPIFY_API_KEY=your_shopify_client_id
# Must be a public HTTPS URL with /shopify/auth/callback registered in Shopify.
# For local testing, use your approved HTTPS tunnel URL (not localhost).
SHOPIFY_APP_URL=https://your-public-tunnel.example
HOST_URL=https://your-public-tunnel.example
CONSOLE_URL=http://localhost:5173
SHOPIFY_SCOPES=read_products,write_products,read_content,write_content,read_orders,read_customers,read_inventory,read_locations,read_metaobjects,write_metaobjects
SHOPIFY_API_VERSION=2025-10

# Local standalone-console testing only: allow requests when a token is stored for the shop.
# Never enable this in production.
# SHOPIFY_DEV_AUTH_BYPASS=true
# Local token store defaults to the ignored ./data/shop-tokens.local.json.
# SHOP_TOKENS_PATH=./data/shop-tokens.local.json

# Legacy Shopify (for existing shopifyApi.js)
# SHOPIFY_CLIENT_ID=your-shopify-client-id
# SHOPIFY_CLIENT_SECRET=your-shopify-client-secret
SHOPIFY_ADMIN_TOKEN=shpat_xxx_or_shpss_xxx
SHOPIFY_REFRESH_TOKEN=your-refresh-token
SHOPIFY_ACCESS_TOKEN=shpat_your_access_token
SHOPIFY_STORE_URL=yourstore.myshopify.com

# ==============================================
# STRIPE BILLING
# ==============================================

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# ==============================================
# DATABASE
# ==============================================

DATABASE_URL=postgresql://username:password@localhost:5432/aura_platform

# ==============================================
# AI SERVICES
# ==============================================

OPENAI_API_KEY=sk-your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# ==============================================
# SESSION
# ==============================================

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_256_bit_random_session_secret
SESSION_DB_PATH=/var/data/aura-core-session.sqlite
DISABLE_SQLITE=false

# ==============================================
# OPTIONAL SERVICES
# ==============================================

KLAVIYO_API_KEY=your_klaviyo_api_key
SENDGRID_API_KEY=your_sendgrid_api_key

# AWS (for S3, etc.)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# ==============================================
# LEGACY / COMPATIBILITY
# ==============================================

DEBUG_KEY=optional-debug-key

# ==============================================
# RENDER.COM (if deploying to Render)
# ==============================================

RENDER_DISK_PATH=/var/data

# ==============================================
# SECURITY & MONITORING
# ==============================================

SENTRY_DSN=your_sentry_dsn
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:10000

# ==============================================
# DEVELOPMENT ONLY
# ==============================================

DEBUG=true
MOCK_EXTERNAL_APIS=false
BYPASS_AUTH=false
